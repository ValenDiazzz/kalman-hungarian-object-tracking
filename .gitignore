# Project files; other root entries stay local.
/*
!/.gitignore
!/.pre-commit-config.yaml
!/.env.example
!/LICENSE
!/README.md
!/pyproject.toml
!/requirements*.txt
!/src/
!/tests/
!/scripts/
!/docs/
!/config/
!/configs/

# Hidden configuration and unreviewed Markdown stay local at any depth.
.*
!/.gitignore
!/.pre-commit-config.yaml
!.env.example
*.[mM][dD]
!/README.md
!/docs/DATA_SOURCES.md
!/docs/DEPENDENCIES.md
!/docs/EXPLAINED_ANIMATION.md
!/docs/REPRODUCIBILITY.md
!/docs/RESULTS.md
!/docs/SECURITY.md
!/docs/TRACKING_INTERPRETATION.md
!/docs/VALIDATION.md

# Local environment configuration and credentials.
.[eE][nN][vV]
.[eE][nN][vV].*
